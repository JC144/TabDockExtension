{
  "manifest_version": 2,
  "homepage_url":"https://tabdock.org/",
  "name": "Tab Dock",
  "version": "2.2",
  "description": "Display a dock with all tabs grouped by domain.",
  "permissions": [
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "incognito": "not_allowed",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {},
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-api.js",
        "Dock/DragReorder.js",
        "Dock/TabItem.js",
        "Dock/DockItem.js",
        "Dock/Dock.js",
        "main.js",
        "content.js"
      ]
    }
  ]
}